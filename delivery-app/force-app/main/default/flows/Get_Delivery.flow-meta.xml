    <description>Read a delivery by number or customer name and return a short answer. Does not create or update records.</description>
    <environments>Default</environments>
    <formulas>
        <name>Answer_With_Driver</name>
        <dataType>String</dataType>
        <expression>&quot;Delivery &quot; &amp; {!delivery.Name} &amp; &quot; for &quot; &amp; {!delivery.Customer_Name__c} &amp; &quot; is &quot; &amp; TEXT({!delivery.Status__c}) &amp; &quot;. Priority is &quot; &amp; TEXT({!delivery.Priority__c}) &amp; &quot;. It is scheduled for &quot; &amp; {!Scheduled_Date_Text} &amp; &quot;. The driver is &quot; &amp; {!Get_Driver.Name} &amp; &quot;. Pickup is &quot; &amp; {!delivery.Pickup_Address__c} &amp; &quot;. Dropoff is &quot; &amp; {!delivery.Dropoff_Address__c} &amp; &quot;.&quot; &amp; {!Delivered_Suffix} &amp; {!Location_Suffix}</expression>
    </formulas>
    <formulas>
        <name>Answer_Without_Driver</name>
        <dataType>String</dataType>
        <expression>&quot;Delivery &quot; &amp; {!delivery.Name} &amp; &quot; for &quot; &amp; {!delivery.Customer_Name__c} &amp; &quot; is &quot; &amp; TEXT({!delivery.Status__c}) &amp; &quot;. Priority is &quot; &amp; TEXT({!delivery.Priority__c}) &amp; &quot;. It is scheduled for &quot; &amp; {!Scheduled_Date_Text} &amp; &quot;. No driver is assigned yet. Pickup is &quot; &amp; {!delivery.Pickup_Address__c} &amp; &quot;. Dropoff is &quot; &amp; {!delivery.Dropoff_Address__c} &amp; &quot;.&quot; &amp; {!Delivered_Suffix} &amp; {!Location_Suffix}</expression>
    </formulas>
    <formulas>
        <name>Delivered_Suffix</name>
        <dataType>String</dataType>
        <expression>IF(AND(ISPICKVAL({!delivery.Status__c}, &quot;Delivered&quot;), NOT(ISBLANK({!delivery.Delivered_On__c}))), &quot; Delivered on &quot; &amp; TEXT({!delivery.Delivered_On__c}) &amp; &quot;.&quot;, &quot;&quot;)</expression>
    </formulas>
    <formulas>
        <name>Location_Suffix</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!delivery.Driver_Location__Latitude__s}), &quot;&quot;, &quot; Last reported location is &quot; &amp; TEXT({!delivery.Driver_Location__Latitude__s}) &amp; &quot;, &quot; &amp; TEXT({!delivery.Driver_Location__Longitude__s}) &amp; &quot;.&quot;)</expression>
    </formulas>
    <formulas>
        <name>List_Answer</name>
        <dataType>String</dataType>
        <expression>{!listText} &amp; &quot;Which delivery do you mean?&quot;</expression>
    </formulas>
    <formulas>
        <name>List_Intro</name>
        <dataType>String</dataType>
        <expression>&quot;I found more than one delivery for &quot; &amp; {!customerName} &amp; &quot;. &quot;</expression>
    </formulas>
    <formulas>
        <name>Match_Line</name>
        <dataType>String</dataType>
        <expression>{!Loop_List.Name} &amp; &quot; is &quot; &amp; TEXT({!Loop_List.Status__c}) &amp; &quot;, scheduled &quot; &amp; TEXT({!Loop_List.Scheduled_Date__c}) &amp; &quot;. &quot;</expression>
    </formulas>
    <formulas>
        <name>Not_Found_Name</name>
        <dataType>String</dataType>
        <expression>&quot;I could not find a delivery for &quot; &amp; {!customerName} &amp; &quot;. Ask for the delivery number or customer name.&quot;</expression>
    </formulas>
    <formulas>
        <name>Not_Found_Number</name>
        <dataType>String</dataType>
        <expression>&quot;I could not find a delivery for &quot; &amp; {!deliveryNumber} &amp; &quot;. Ask for the delivery number or customer name.&quot;</expression>
    </formulas>
    <formulas>
        <name>Only_Lookup</name>
        <dataType>String</dataType>
        <expression>&quot;I can only look up a delivery. Provide a delivery number or customer name.&quot;</expression>
    </formulas>
    <formulas>
        <name>Scheduled_Date_Text</name>
        <dataType>String</dataType>
        <expression>CASE(MONTH({!delivery.Scheduled_Date__c}), 1, &quot;January&quot;, 2, &quot;February&quot;, 3, &quot;March&quot;, 4, &quot;April&quot;, 5, &quot;May&quot;, 6, &quot;June&quot;, 7, &quot;July&quot;, 8, &quot;August&quot;, 9, &quot;September&quot;, 10, &quot;October&quot;, 11, &quot;November&quot;, 12, &quot;December&quot;, &quot;&quot;) &amp; &quot; &quot; &amp; TEXT(DAY({!delivery.Scheduled_Date__c})) &amp; &quot;, &quot; &amp; TEXT(YEAR({!delivery.Scheduled_Date__c}))</expression>
    </formulas>
