{
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node ./hooks/cursor-hook.cjs deploy",
        "failClosed": true,
        "timeout": 40,
        "matcher": "[Ss][Ff]|[Ss][Ff][Dd][Xx]|[Dd]eploy|[Dd]elete"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node ./hooks/cursor-hook.cjs confirm",
        "timeout": 10
      }
    ]
  }
}
